{
  "supportedVersions": [
    15,
    16,
    17,
    18,
    19
  ],
  "defaultVersion": 18,
  "sections": {
    "client_backends": {
      "title": "Client Backends",
      "desc": "Dedicated backend processes spawned to serve active client database connections.",
      "docsUrl": "https://www.postgresql.org/docs/current/connect-estab.html",
      "extraLink": { "label": "Lock monitoring queries", "url": "https://wiki.postgresql.org/wiki/Lock_Monitoring" }
    },
    "query_planning": {
      "title": "Query Planning",
      "desc": "Query optimizer module producing execution plans from parsed SQL.",
      "docsUrl": "https://www.postgresql.org/docs/current/planner-optimizer.html",
      "extraLink": { "label": "Explaining the unexplainable", "url": "https://www.depesz.com/2013/04/16/explaining-the-unexplainable/" }
    },
    "query_execution": {
      "title": "Query Execution",
      "desc": "Executor engine processing plan nodes and allocating work memory.",
      "docsUrl": "https://www.postgresql.org/docs/current/executor.html",
      "extraLink": { "label": "PostgreSQL 14 Internals", "url": "https://postgrespro.com/community/books/internals" }
    },
    "shared_buffers": {
      "title": "Shared Buffers",
      "desc": "Primary shared memory buffer cache storing database table and index pages.",
      "docsUrl": "https://www.postgresql.org/docs/current/runtime-config-resource.html#RUNTIME-CONFIG-RESOURCE-MEMORY",
      "extraLink": { "label": "Internals of PostgreSQL", "url": "https://www.interdb.jp/pg/" }
    },
    "slru_caches": {
      "title": "SLRU Caches",
      "desc": "Simple LRU caches tracking transaction commit logs (clog, multixact, subtrans).",
      "docsUrl": "https://www.postgresql.org/docs/current/monitoring-stats.html"
    },
    "postmaster": {
      "title": "Postmaster Process",
      "desc": "Master supervisor process handling initialization, authentication, and process forks.",
      "docsUrl": "https://www.postgresql.org/docs/current/server-start.html",
      "extraLink": { "label": "Internals of PostgreSQL", "url": "https://www.interdb.jp/pg/" }
    },
    "bg_workers": {
      "title": "Background Workers",
      "desc": "Dynamic background processes executing parallel queries and background tasks.",
      "docsUrl": "https://www.postgresql.org/docs/current/bgworker.html",
      "extraLink": { "label": "Internals of PostgreSQL", "url": "https://www.interdb.jp/pg/" }
    },
    "autovacuum_workers": {
      "title": "Autovacuum",
      "desc": "Processes removing dead tuples and updating table planner statistics.",
      "docsUrl": "https://www.postgresql.org/docs/current/routine-vacuuming.html",
      "extraLink": { "label": "Tuning autovacuum", "url": "https://www.cybertec-postgresql.com/en/tuning-autovacuum-postgresql/" }
    },
    "indexes_usage": {
      "title": "Indexes Usage",
      "desc": "Index access counters and structural health metrics (B-Tree, GIN, GiST, BRIN).",
      "docsUrl": "https://www.postgresql.org/docs/current/monitoring-stats.html",
      "extraLink": { "label": "PostgreSQL 14 Internals", "url": "https://postgrespro.com/community/books/internals" }
    },
    "tables_usage": {
      "title": "Tables Usage",
      "desc": "Table access metrics, sequential scan rates, and tuple mutation counters.",
      "docsUrl": "https://www.postgresql.org/docs/current/monitoring-stats.html",
      "extraLink": { "label": "PostgreSQL 14 Internals", "url": "https://postgrespro.com/community/books/internals" }
    },
    "buffers_io": {
      "title": "Buffer IO & Statistics Subsystem",
      "desc": "Disk I/O subsystem tracking reads, writes, and buffer pool operations (pg_stat_io).",
      "docsUrl": "https://www.postgresql.org/docs/current/monitoring-stats.html",
      "extraLink": { "label": "EXPLAIN and buffers", "url": "https://www.depesz.com/2021/06/20/explaining-the-unexplainable-part-6-buffers/" }
    },
    "wal": {
      "title": "Write-Ahead Log (WAL)",
      "desc": "Transaction logging engine ensuring ACID durability (pg_stat_wal).",
      "docsUrl": "https://www.postgresql.org/docs/current/wal-intro.html",
      "extraLink": { "label": "Internals of PostgreSQL", "url": "https://www.interdb.jp/pg/" }
    },
    "logger": {
      "title": "Logger Process",
      "desc": "Process capturing error messages and server activity into log files.",
      "docsUrl": "https://www.postgresql.org/docs/current/runtime-config-logging.html"
    },
    "replication": {
      "title": "Replication",
      "desc": "Publish-subscribe subsystem streaming decoded logical data changes.",
      "docsUrl": "https://www.postgresql.org/docs/current/logical-replication.html",
      "extraLink": { "label": "Internals of PostgreSQL", "url": "https://www.interdb.jp/pg/" }
    },
    "wal_sender": {
      "title": "WAL Sender Process",
      "desc": "Streams WAL record bytes to streaming replication standby nodes.",
      "docsUrl": "https://www.postgresql.org/docs/current/runtime-config-replication.html#RUNTIME-CONFIG-REPLICATION-SENDER"
    },
    "wal_archiver": {
      "title": "WAL Archiver Process",
      "desc": "Executes archive commands to store completed WAL segments in backup storage.",
      "docsUrl": "https://www.postgresql.org/docs/current/continuous-archiving.html"
    },
    "bg_writer": {
      "title": "Background Writer",
      "desc": "Flushes dirty buffers to disk gradually to minimize checkpoint spikes.",
      "docsUrl": "https://www.postgresql.org/docs/current/runtime-config-resource.html#RUNTIME-CONFIG-RESOURCE-BACKGROUND-WRITER",
      "extraLink": { "label": "pg_stat_io for DBAs", "url": "https://pganalyze.com/blog/5mins-postgres-16-pg-stat-io-dba" }
    },
    "checkpointer": {
      "title": "Checkpointer Process",
      "desc": "Creates periodic checkpoints flushing dirty pages to disk (pg_stat_checkpointer).",
      "docsUrl": "https://www.postgresql.org/docs/current/wal-configuration.html",
      "extraLink": { "label": "PostgreSQL 14 Internals", "url": "https://postgrespro.com/community/books/internals" }
    },
    "network": {
      "title": "Network Layer",
      "desc": "TCP/IP or Unix socket interface handling client communications.",
      "docsUrl": "https://www.postgresql.org/docs/current/connect-estab.html"
    },
    "storage": {
      "title": "Storage System",
      "desc": "Underlying file system and physical block storage devices.",
      "docsUrl": "https://www.postgresql.org/docs/current/storage.html"
    },
    "wal_receiver": {
      "title": "WAL Receiver Process",
      "desc": "Receives WAL stream from primary instance on standby replicas.",
      "docsUrl": "https://www.postgresql.org/docs/current/runtime-config-replication.html#RUNTIME-CONFIG-REPLICATION-STANDBY"
    },
    "recovery_process": {
      "title": "Recovery Process",
      "desc": "Replays WAL records during crash recovery or standby replay.",
      "docsUrl": "https://www.postgresql.org/docs/current/runtime-config-wal.html#RUNTIME-CONFIG-WAL-RECOVERY-TARGET",
      "extraLink": { "label": "Internals of PostgreSQL", "url": "https://www.interdb.jp/pg/" }
    },
    "data_files": {
      "title": "Tables / Indexes Data Files",
      "desc": "Physical data relation files, TOAST tables, and tablespace directories.",
      "docsUrl": "https://www.postgresql.org/docs/current/storage-file-layout.html",
      "extraLink": { "label": "Internals of PostgreSQL", "url": "https://www.interdb.jp/pg/" }
    }
  },
